# macOS
.DS_Store

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# playwright (E2E) — generated reports/artifacts + browser cache, never commit
/test-results/
/playwright-report/
/playwright/.cache/

# next.js
.next/
out/
next-env.d.ts

# production
build/
dist/

# environment / secrets — never commit
.env
.env.*
!.env.example
!.env.*.example

# local DB exports / backups — may contain PII, never commit
.backups/

# editor / IDE
.vscode/
.idea/
*.swp
*.swo

# vercel
.vercel

# supabase local dev (only the local-state stuff; migrations are tracked)
supabase/.branches
supabase/.temp
supabase/.env

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# turbo
.turbo

# typescript build info
*.tsbuildinfo
.env*.local

# Local DB backups/snapshots (never commit)
.backups/
public/pdf.worker.min.mjs
