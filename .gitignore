# macOS
.DS_Store

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# playwright (E2E) — generated reports/artifacts + browser cache, never commit
/test-results/
/playwright-report/
/playwright/.cache/

# next.js
.next/
out/
next-env.d.ts

# production
build/
dist/

# environment / secrets — never commit
.env
.env.*
!.env.example
!.env.*.example

# local DB exports / backups — may contain PII, never commit
.backups/

# editor / IDE
.vscode/
.idea/
*.swp
*.swo

# vercel
.vercel

# supabase local dev (only the local-state stuff; migrations are tracked)
supabase/.branches
supabase/.temp
supabase/.env

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# turbo
.turbo

# typescript build info
*.tsbuildinfo
.env*.local

# Local DB backups/snapshots (never commit)
.backups/
public/pdf.worker.min.mjs

# Authenticated-E2E harness storageState (live JWT — never commit)
/e2e/.auth/

# Licensed marketing fonts (Clash Display, Satoshi): the ITF Free Font License
# forbids putting the files in a public repository. They are supplied at build
# time by scripts/fonts/provision-marketing-fonts.mjs (see
# docs/compliance/FONT-LICENCE-RESOLUTION.md); guarded by
# __tests__/security/restricted-font-binaries.test.ts.
/app/_marketing/fonts/active/
/.fonts-private/
*[Cc]lash[Dd]isplay*.woff
*[Cc]lash[Dd]isplay*.woff2
*[Cc]lash[Dd]isplay*.[ot]tf
*[Ss]atoshi*.woff
*[Ss]atoshi*.woff2
*[Ss]atoshi*.[ot]tf
