# [CONFIG]
FEATURE_GDPR_ERASURE=
# [CONFIG]
FEATURE_RETENTION_PURGE=
# [CONFIG]
FEATURE_CALENDAR_CONNECT=
# [CONFIG]
FEATURE_ACCOUNTING_CONNECT=
# [CONFIG]
FEATURE_MFA_ENFORCEMENT=
# [CONFIG]
FEATURE_PUBLIC_API_JOBS=
# [CONFIG]
