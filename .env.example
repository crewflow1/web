QBO_CLIENT_SECRET=
# [CONFIG]
SAGE_CLIENT_ID=
# [SECRET]
SAGE_CLIENT_SECRET=
# [CONFIG]
GOOGLE_CALENDAR_CLIENT_ID=
# [SECRET]
GOOGLE_CALENDAR_CLIENT_SECRET=
# [CONFIG]
MS_GRAPH_CLIENT_ID=
# [SECRET]
MS_GRAPH_CLIENT_SECRET=
# [CONFIG]
BANKING_PROVIDER=
# [CONFIG]
BANKING_CLIENT_ID=
# [SECRET]
BANKING_CLIENT_SECRET=
# [CONFIG]
TELEMATICS_PROVIDER=
# [CONFIG]
TELEMATICS_CLIENT_ID=
# [SECRET]
TELEMATICS_CLIENT_SECRET=
# [CONFIG]
ACCOUNTING_REDIRECT_URI=
# [CONFIG]
SAGE_API_BASE_URL=
# [CONFIG]
SAGE_SALES_LEDGER_ACCOUNT_ID=
# [CONFIG]
SAGE_BANK_ACCOUNT_ID=
# [CONFIG]
XERO_BANK_ACCOUNT_CODE=
