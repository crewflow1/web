# CrewFlow — environment variable reference.
#
# Every variable NAME the application reads (lib/env.ts + direct process.env
# reads), grouped by provider. THIS FILE CONTAINS NO REAL VALUES AND MUST NEVER
# CONTAIN ONE: copy it to .env.local (git-ignored) and fill that in instead.
# Kept in step with the code by __tests__/security/env-example-coverage.test.ts.
#
# Each variable is tagged:
#   [PUBLIC]   NEXT_PUBLIC_* or otherwise public by design. Inlined into the
#              browser bundle / visible to anyone. Never put a secret here.
#   [SECRET]   A credential. Server-only. Lives in Vercel (Production / Preview
#              env) or a local, git-ignored .env.local — never in git, never in
#              a NEXT_PUBLIC_ name, never in a client component.
#   [CONFIG]   Non-secret server configuration.
#   [PLATFORM] Injected by the runtime; do not set by hand.
#
# Only three are required to boot: NEXT_PUBLIC_APP_URL, NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_ANON_KEY. Everything else is optional and its absence
# leaves the matching capability dark (fail-closed).
#
# Register of where each secret is used and stored:
#   docs/programme/security-secrets/SECRETS-REGISTER.md

# ──────────────────────────────────────────────────────────────────────────
# App
# Core app identity. NEXT_PUBLIC_APP_URL is required.
# ──────────────────────────────────────────────────────────────────────────
# [PUBLIC] required
NEXT_PUBLIC_APP_URL=http://localhost:3000
# [PUBLIC]
NEXT_PUBLIC_APP_NAME=CrewFlow
# [CONFIG] development | preview | production
APP_ENV=development
# [PLATFORM] set by the runtime — do not set by hand
NODE_ENV=
# [CONFIG] comma-separated HQ super-admin emails. Not a credential, but it GRANTS HQ access — treat as sensitive config
CREWFLOW_SUPERADMIN_EMAILS=
# [CONFIG] uuid of CrewFlow's own org; HQ AI spend is billed to it (fail-closed when unset)
CREWFLOW_INTERNAL_ORG_ID=
# [CONFIG]
MAINTENANCE_MODE=
# [SECRET] shared secret that bypasses maintenance mode
MAINTENANCE_BYPASS=

# ──────────────────────────────────────────────────────────────────────────
# Supabase
# URL + anon key are PUBLIC BY DESIGN (RLS is the boundary). The service-role key bypasses RLS: server only, never NEXT_PUBLIC_.
# ──────────────────────────────────────────────────────────────────────────
# [PUBLIC] required
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# [PUBLIC] required — anon/publishable key (public by design)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [SECRET] bypasses RLS + grants. Vercel (Production/Preview) only
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Stripe (billing)
# ──────────────────────────────────────────────────────────────────────────
# [SECRET] prod uses a RESTRICTED live key
STRIPE_SECRET_KEY=
# [SECRET]
STRIPE_WEBHOOK_SECRET=
# [SECRET]
STRIPE_INVOICE_WEBHOOK_SECRET=
# [SECRET] portal card payments (dark)
STRIPE_CONNECT_SECRET_KEY=
# [PUBLIC] publishable key (public by design)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# [CONFIG]
STRIPE_SETUP_PRICE_ID=
# [CONFIG]
STRIPE_SUBSCRIPTION_PRICE_ID=

# ──────────────────────────────────────────────────────────────────────────
# Email (Resend)
# ──────────────────────────────────────────────────────────────────────────
# [SECRET]
RESEND_API_KEY=
# [SECRET] Resend events webhook signing secret (dark)
RESEND_WEBHOOK_SECRET=
# [SECRET] inbound email HMAC secret (dark)
INBOUND_EMAIL_WEBHOOK_SECRET=
# [CONFIG]
RESEND_FROM_EMAIL=
# [CONFIG]
RESEND_REPLY_TO=
# [CONFIG]
RESEND_NOTIFICATIONS_FROM=
# [CONFIG]
DEMO_NOTIFY_EMAIL=

# ──────────────────────────────────────────────────────────────────────────
# AI providers
# A key alone arms every tier bound in lib/ai/governor/registry.ts. Spend is governed in-app (docs/ai-cost-governor.md) — set a PROVIDER-SIDE spend limit as well.
# ──────────────────────────────────────────────────────────────────────────
# [SECRET] text + vision (cheap/mid/high tiers)
ANTHROPIC_API_KEY=
# [SECRET] embeddings + default transcription credential
OPENAI_API_KEY=
# [SECRET] optional dedicated STT key; wins over OPENAI_API_KEY
TRANSCRIPTION_API_KEY=
# [CONFIG] auto | anthropic | openai | off
MEMORY_TEXT_PROVIDER=
# [CONFIG]
MEMORY_EMBEDDING_PROVIDER=
# [CONFIG]
AI_VISION_PROVIDER=

# ──────────────────────────────────────────────────────────────────────────
# Telephony / SMS (Twilio, Vapi) — DARK
# ──────────────────────────────────────────────────────────────────────────
# [CONFIG] identifier, not a credential on its own
TWILIO_ACCOUNT_SID=
# [SECRET]
TWILIO_AUTH_TOKEN=
# [CONFIG]
TWILIO_API_KEY_SID=
# [SECRET]
TWILIO_API_KEY_SECRET=
# [CONFIG]
TWILIO_SMS_FROM=
# [CONFIG]
TWILIO_STATUS_CALLBACK_URL=
# [CONFIG]
TWILIO_VOICE_STATUS_CALLBACK_URL=
# [SECRET]
VAPI_WEBHOOK_SECRET=
# [CONFIG]
VAPI_WEBHOOK_HMAC=
# [CONFIG]
VAPI_CUSTOM_LLM_URL=
# [SECRET] shared secret for /api/receptionist/inbound
CHANNEL_INBOUND_SECRET=
# [CONFIG]
COMMS_EMAIL_PROVIDER=
# [CONFIG]
COMMS_SMS_PROVIDER=
# [CONFIG]
COMMS_WHATSAPP_PROVIDER=
# [CONFIG]
COMMS_VOICE_PROVIDER=

# ──────────────────────────────────────────────────────────────────────────
# WhatsApp (Meta Cloud API) — DARK
# ──────────────────────────────────────────────────────────────────────────
# [SECRET] keys the inbound webhook HMAC
WHATSAPP_APP_SECRET=
# [SECRET] subscription handshake shared string
WHATSAPP_VERIFY_TOKEN=
# [SECRET]
WHATSAPP_ACCESS_TOKEN=
# [CONFIG]
WHATSAPP_PHONE_NUMBER_ID=
# [CONFIG]
WHATSAPP_GRAPH_VERSION=
# [CONFIG]
WHATSAPP_TEST_RECIPIENT_ALLOWLIST=

# ──────────────────────────────────────────────────────────────────────────
# Web push (VAPID) — DARK
# ──────────────────────────────────────────────────────────────────────────
# [PUBLIC] public half of the VAPID pair
VAPID_PUBLIC_KEY=
# [SECRET]
VAPID_PRIVATE_KEY=
# [CONFIG]
VAPID_SUBJECT=

# ──────────────────────────────────────────────────────────────────────────
# Crons, cache, rate limiting
# ──────────────────────────────────────────────────────────────────────────
# [SECRET] Vercel sends it as a Bearer on every cron; unset ⇒ all 48 crons refuse
CRON_SECRET=
# [CONFIG]
KV_REST_API_URL=
# [SECRET] Vercel KV / Upstash REST token
KV_REST_API_TOKEN=

# ──────────────────────────────────────────────────────────────────────────
# Monitoring + analytics
# The Sentry DSN and the PostHog project key are public identifiers by design.
# ──────────────────────────────────────────────────────────────────────────
# [PUBLIC]
NEXT_PUBLIC_SENTRY_DSN=
# [CONFIG] server-side DSN (same public identifier)
SENTRY_DSN=
# [CONFIG]
SENTRY_ORG=
# [CONFIG]
SENTRY_PROJECT=
# [SECRET] build-time source-map upload token (Vercel build env only)
SENTRY_AUTH_TOKEN=
# [CONFIG]
SENTRY_DASHBOARD_URL=
# [PUBLIC]
NEXT_PUBLIC_POSTHOG_KEY=
# [PUBLIC]
NEXT_PUBLIC_POSTHOG_HOST=
# [CONFIG]
ANALYTICS_SERVER_ENABLED=
# [SECRET]
POSTHOG_SERVER_KEY=
# [CONFIG]
POSTHOG_SERVER_HOST=

# ──────────────────────────────────────────────────────────────────────────
# HQ integrations (internal tooling)
# ──────────────────────────────────────────────────────────────────────────
# [SECRET]
COMPANIES_HOUSE_API_KEY=
# [SECRET]
GITHUB_TOKEN=
# [CONFIG]
GITHUB_REPO=
# [SECRET]
VERCEL_TOKEN=
# [CONFIG]
VERCEL_PROJECT_ID=
# [CONFIG]
VERCEL_TEAM_ID=
# [CONFIG]
FEATURE_HQ_AUTONOMOUS_APPLY=
# [CONFIG]
CREWFLOW_EXECUTOR_APPLY=
# [CONFIG]
CREWFLOW_HQ_APPLY_ON_APPROVAL=
# [CONFIG]
CREWFLOW_EXECUTOR_SHADOW=

# ──────────────────────────────────────────────────────────────────────────
# Customer integrations — OAuth clients + token encryption (DARK)
