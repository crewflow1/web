# [SECRET] encrypts stored OAuth tokens at rest. Losing or rotating it without re-encryption orphans every stored token
INTEGRATION_TOKEN_ENCRYPTION_KEY=
# [CONFIG]
HMRC_CLIENT_ID=
# [SECRET]
HMRC_CLIENT_SECRET=
# [CONFIG]
XERO_CLIENT_ID=
# [SECRET]
XERO_CLIENT_SECRET=
# [CONFIG]
QBO_CLIENT_ID=
