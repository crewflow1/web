# ──────────────────────────────────────────────────────────────────────────
# Preview-only test login
# NEVER set in Production. The route 404s in production regardless, but a Preview deployment that shares the production database turns this token into a login to production data.
# ──────────────────────────────────────────────────────────────────────────
# [SECRET]
DEV_TEST_LOGIN_TOKEN=
# [CONFIG]
DEV_TEST_USER_EMAIL=

# ──────────────────────────────────────────────────────────────────────────
# Platform-injected (Vercel) — do not set by hand
# ──────────────────────────────────────────────────────────────────────────
# [PLATFORM]
VERCEL_ENV=
# [PLATFORM]
VERCEL_GIT_COMMIT_SHA=
# [PLATFORM]
VERCEL_GIT_COMMIT_AUTHOR_DATE=
# [PLATFORM]
VERCEL_GIT_COMMIT_REF=
# [PLATFORM]
NEXT_PUBLIC_VERCEL_ENV=
# [PLATFORM]
NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=

# ──────────────────────────────────────────────────────────────────────────
# SDK generator (sdks/) — developer machine only
# ──────────────────────────────────────────────────────────────────────────
# [SECRET] a CrewFlow public-API key used by the SDK examples; never a server env var
CREWFLOW_API_KEY=

# ── Billing (#1090) ──────────────────────────────────────────────────────────
# [CONFIG] "true" disables owner self-serve cancellation (incident kill switch; HQ can still cancel)
BILLING_SELF_SERVE_CANCELLATION_DISABLED=
