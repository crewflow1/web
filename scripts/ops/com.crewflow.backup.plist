<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  CrewFlow off-platform encrypted backup — DAILY launchd agent.

  The scheduler is ONLY an execution mechanism. Backup health is judged by the
  validated heartbeat in ops_backup_runs (surfaced in /admin/ops), NOT by whether
  this agent fired. launchd (unlike cron) runs a MISSED StartCalendarInterval job
  once on the next wake; and if the Mac is off long enough that a run is skipped,
  /admin/ops goes WARNING (>7d) then RED (>10d) — so a miss can never be silent.

  INSTALL (one-time, founder):
    cp scripts/ops/off-platform-backup.sh ~/.local/bin/crewflow-off-platform-backup.sh
    chmod +x ~/.local/bin/crewflow-off-platform-backup.sh
    cp scripts/ops/com.crewflow.backup.plist ~/Library/LaunchAgents/com.crewflow.backup.plist
    launchctl load  ~/Library/LaunchAgents/com.crewflow.backup.plist   # (or: launchctl bootstrap gui/$UID ...)
  RUN NOW (manual):   launchctl start com.crewflow.backup
  STATUS:             launchctl list | grep com.crewflow.backup
  UNINSTALL:          launchctl unload ~/Library/LaunchAgents/com.crewflow.backup.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.crewflow.backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/moetalibi/.local/bin/crewflow-off-platform-backup.sh</string>
  </array>

  <!-- DAILY, with catch-up slots. At 03:17 a laptop is normally asleep: launchd then fires the job
       inside a few-second DarkWake, and before 2026-11-15 the machine went straight back to sleep
       mid-backup (every 03:17 run failed that way). The script now holds the machine awake
       (caffeinate) — and because a closed lid on battery can still force sleep, three daytime slots
       retry. A slot that finds today's verified backup already off-site exits without doing
       anything, so at most ONE backup is taken per day. A slot missed while the Mac was asleep or
       off is run once by launchd on the next wake. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>17</integer></dict>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>17</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>17</integer></dict>
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>17</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <false/>

  <!-- node/supabase are in /opt/homebrew/bin, not on launchd's default PATH. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- RETENTION HOLD (2026-11-15): keep every existing backup until the retention policy has
         been explicitly reviewed. Remove this key to return to the script default (last 8). -->
    <key>CF_BACKUP_RETENTION</key>
    <string>1000</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/moetalibi/.local/state/crewflow-backup/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/moetalibi/.local/state/crewflow-backup/launchd.err.log</string>

  <!-- Low priority; do not keep alive (it's a periodic job, not a daemon). -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
