{
  "name": "crewflow-web",
  "version": "0.1.0",
  "private": true,
  "description": "CrewFlow — AI receptionist + quotes for construction companies.",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=6144 next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:seed": "tsx scripts/seed.ts",
    "email": "email dev --dir emails --port 3001",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:e2e": "playwright test",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "db:types": "supabase gen types typescript --linked > lib/supabase/types.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@dnd-kit/core": "^6.3.1",
    "@hookform/resolvers": "^3.9.0",
    "@react-email/components": "^0.0.31",
    "@react-pdf/renderer": "^4.0.0",
    "@sentry/nextjs": "^8.40.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-virtual": "^3.14.3",
    "@vercel/kv": "^3.0.0",
    "@vercel/og": "^0.6.5",
    "@xmldom/xmldom": "^0.9.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "jszip": "^3.10.1",
    "libphonenumber-js": "^1.11.15",
    "lucide-react": "^0.460.0",
    "next": "^15.0.4",
    "openai": "^4.74.0",
    "pdfjs-dist": "4.10.38",
    "posthog-js": "^1.187.0",
    "posthog-node": "^4.3.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-email": "^3.0.4",
    "react-hook-form": "^7.54.0",
    "resend": "^4.0.1",
    "server-only": "^0.0.1",
    "stripe": "^17.4.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "twilio": "^5.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xml-crypto": "^6.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.0.4",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
